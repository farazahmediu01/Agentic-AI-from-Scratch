# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored so the key never leaves your machine.

# =============================================================================
# Which provider the SDK chapters use.
#
#   gemini  (default) -> Chat Completions API, free. Use this for the whole
#                        curriculum. Everything below under "Gemini" applies.
#   openai            -> Responses API, PAID. Needed only for the hosted-tools
#                        chapter (web search, file search, code interpreter),
#                        which cannot run on Chat Completions.
#
# See RESPONSES_VS_CHATCOMPLETIONS.md for why the default is what it is.
# Check which one you are on:  uv run python -m shared.models
# =============================================================================
AGENT_PROVIDER=gemini

# ----------------------------------------------------------------------------
# Gemini — the free path. Required.
#
# These keep the OPENAI_* names because the OpenAI Python SDK reads them and
# every `from_scratch/` script builds its client from them directly.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Pick any Gemini model that supports tool calling.
# Free-tier friendly options as of mid-2026: gemini-2.5-flash, gemini-2.0-flash
MODEL_NAME=gemini-3.1-flash-lite

# ----------------------------------------------------------------------------
# OpenAI — the paid path. Leave blank unless you are on the hosted-tools chapter.
#
# Deliberately a DIFFERENT variable name from OPENAI_API_KEY above. If they
# shared a name, flipping AGENT_PROVIDER would send your Gemini key to
# api.openai.com and fail with a confusing 401.
# ----------------------------------------------------------------------------
# OPENAI_PLATFORM_API_KEY=sk-your_real_paid_openai_key_here
# OPENAI_MODEL=gpt-4o
